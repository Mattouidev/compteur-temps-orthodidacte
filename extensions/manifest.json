{
  "manifest_version": 3,
  "name": "Compteur de temps pour Orthodidacte (non officiel)",
  "version": "1.3.0",
  "description": "Additionne automatiquement le temps de chaque exercice Orthodidacte terminé. Non officielle, non affiliée à Orthodidacte.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.orthodidacte.com/*",
    "*://orthodidacte.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.orthodidacte.com/*",
        "*://orthodidacte.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Compteur de temps (non officiel)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Temps Ortho"
}
